    {
      "name": "1 · Funcionário: login e cadastro",
      "item": [
        {
          "name": "Login do funcionário",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/token",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{usuario}}"
                },
                {
                  "key": "password",
                  "value": "{{senha}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"tokenFuncionario\", pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Cadastrar cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/cadastro/clientes",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenFuncionario}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Cliente da Demonstração\",\n  \"cpf_cnpj\": \"{{cpf}}\",\n  \"email\": \"cliente@exemplo.com\",\n  \"telefone\": \"11999990000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// CPF válido e novo a cada execução.",
                  "const d = Array.from({ length: 9 }, () => Math.floor(Math.random() * 10));",
                  "const dv = (n) => { const r = n.reduce((s, x, i) => s + x * (n.length + 1 - i), 0) % 11; return r < 2 ? 0 : 11 - r; };",
                  "d.push(dv(d)); d.push(dv(d));",
                  "pm.collectionVariables.set(\"cpf\", d.join(\"\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"clienteId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Cadastrar veículo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/cadastro/veiculos",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenFuncionario}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"placa\": \"{{placa}}\",\n  \"marca\": \"Volkswagen\",\n  \"modelo\": \"Gol\",\n  \"ano\": \"2020\",\n  \"cliente_id\": \"{{clienteId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Placa Mercosul aleatória: AAA1A23.",
                  "const letra = () => String.fromCharCode(65 + Math.floor(Math.random() * 26));",
                  "const digito = () => Math.floor(Math.random() * 10);",
                  "pm.collectionVariables.set(\"placa\", `${letra()}${letra()}${letra()}${digito()}${letra()}${digito()}${digito()}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"veiculoId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Cadastrar serviço",
