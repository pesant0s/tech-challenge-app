# Banco local do docker compose; em AWS vem do Secrets Manager
DATABASE_URL=postgresql://oficina:oficina@db:5432/oficina
POSTGRES_USER=oficina
POSTGRES_PASSWORD=oficina
POSTGRES_DB=oficina

# SECRET_KEY precisa ser a mesma da Lambda de autenticação
SECRET_KEY=troque-por-uma-chave-aleatoria-de-pelo-menos-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
WEBHOOK_SECRET=troque-por-segredo-aleatorio-para-webhook-email
ALLOWED_ORIGINS=["http://localhost:3000"]

# Sem licença, o agente do New Relic fica desligado
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=tech-challenge-oficina

LOG_FORMAT=console
LOG_LEVEL=INFO
